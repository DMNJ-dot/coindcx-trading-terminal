# ===============================================================
# CoinDCX Trading Terminal Environment Configuration Template
# ===============================================================

# Operating Mode: 'paper' (default), 'testnet', 'live', 'backtest'
TRADING_MODE=paper
LIVE_TRADING_CONFIRMED=false

# Public Web Hosting Protection (Recommended when hosted online)
# Leave DASHBOARD_PASSWORD empty for friction-free local usage
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Server Binding
HOST=0.0.0.0
PORT=8000

# CoinDCX API Credentials
# Obtain from https://coindcx.com/profile/api
# NOTE: CoinDCX requires IP binding for API keys.
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# Target Perpetual Instrument
DEFAULT_SYMBOL=B-BTC_USDT
TIMEFRAME=5m

# Sizing & Risk Controls
STARTING_EQUITY=10000.0
RISK_PCT_PER_TRADE=0.005
MAX_LEVERAGE=10.0
DAILY_LOSS_LIMIT_PCT=0.02
COOLDOWN_BARS=3
MAX_HOLD_BARS=6
MAX_OPEN_POSITIONS=1
SLIPPAGE_RATE=0.0003
FIXED_SPREAD=0.50

# Strategy Parameters
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
ATR_PERIOD=14
VOL_MA_PERIOD=20
VOL_TRIGGER_MULTIPLIER=0.8
PULLBACK_TOLERANCE=0.0005
STOP_ATR_MULTIPLIER=0.25
MIN_STOP_PCT=0.0020
MAX_STOP_PCT=0.0035
TAKE_PROFIT_RR=3.0
SESSION_START_HOUR=7.5
SESSION_END_HOUR=16.5

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_ENABLED=false
